__pycache__/
*.pyc
build/
dist/
*.egg-info/
.venv/
.pytest_cache/
# the native core: modules built in place (native/build.sh, pip) are never committed; the cross-built
# artefacts of the reference deployment under native/dist/ are (the installer takes them from there)
*.so
!native/dist/**/*.so
# recordings, captures and map packs never belong in the repository
*.jsonl.gz
*.cap.gz
*.rsmap
*.jpg
